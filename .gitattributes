# Normalizar finales de línea en el repositorio (LF)
* text=auto eol=lf

*.lua text eol=lf
*.toc text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.editorconfig text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf

# Recursos binarios del addon
*.tga binary
*.blp binary
*.png binary
*.jpg binary
*.zip binary